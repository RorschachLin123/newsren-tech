# Copy this file to .env and fill in ONE provider. .env is git-ignored; never commit a real key.

# --- Option A (default): DeepSeek, OpenAI-compatible API. Key: https://platform.deepseek.com/api_keys
NEWSREN_LLM=deepseek
DEEPSEEK_API_KEY=
# NEWSREN_MODEL=deepseek-flash          # default; deepseek-v4-pro is the larger model
# NEWSREN_THINKING=disabled             # "enabled" turns on DeepSeek's thinking mode (slower, more output tokens)

# --- Option B: Anthropic API
# NEWSREN_LLM=anthropic
# ANTHROPIC_API_KEY=
# NEWSREN_MODEL=claude-sonnet-5-5

# --- Option C: any other OpenAI-compatible endpoint
# NEWSREN_LLM=openai-compatible
# NEWSREN_BASE_URL=https://api.example.com/v1
# NEWSREN_API_KEY=
# NEWSREN_MODEL=
# NEWSREN_PRICE_IN=0.0                  # USD per 1M input tokens, for the cost meter
# NEWSREN_PRICE_OUT=0.0                 # USD per 1M output tokens

# --- Option D: the Claude Code CLI (`claude -p`), billed to its own login; no key needed here
# NEWSREN_LLM=claude-cli
